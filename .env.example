# Server-side database connection (preferred).
# Use the Supabase Postgres connection string.
# Example: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Session signing secret (long random string, 32+ characters recommended)
SESSION_SECRET=replace-with-a-long-random-secret

# bcrypt password hashes for founder accounts (base64-encoded)
# Generate with: npm run hash-password -- "your-password"
# The script prints values safe to paste into .env files (no $ expansion issues).
JON_PASSWORD_HASH=replace_with_base64_bcrypt_hash_for_jon
AHMED_PASSWORD_HASH=replace_with_base64_bcrypt_hash_for_ahmed

# Optional: Supabase project URL (not required by the app when using DATABASE_URL)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
