# Server-side database connection (preferred).
# Use the Supabase Postgres connection string.
# Example: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Session signing secret (long random string, 32+ characters recommended)
SESSION_SECRET=replace-with-a-long-random-secret

# bcrypt password hashes for founder accounts
# Generate with: npm run hash-password -- "your-password"
# Escape every $ as \$ in .env files (Next.js expands $VAR), or paste the
# escaped line printed by the hash-password script.
JON_PASSWORD_HASH=\$2a\$12\$replace_with_bcrypt_hash_for_jon
AHMED_PASSWORD_HASH=\$2a\$12\$replace_with_bcrypt_hash_for_ahmed

# Optional: Supabase project URL (not required by the app when using DATABASE_URL)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
