# Server-side database connections.
#
# App / serverless traffic → transaction pooler (port 6543).
# Migrations / seeds / admin → session pooler or direct (port 5432).
#
# Production Workers use Hyperdrive (wrangler.jsonc). Local `next dev` uses
# DATABASE_URL_POOLED (or derives :6543 from a pooler DATABASE_URL).
#
# Session / direct (migrations, db:seed, smoke admin):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:5432/postgres
#
# Transaction pooler (Next.js app traffic — preferred explicit setting):
# DATABASE_URL_POOLED=postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:6543/postgres
#
# If DATABASE_URL_POOLED is unset and DATABASE_URL points at *.pooler.supabase.com:5432,
# the app derives the transaction URL on the same host with port 6543.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL_POOLED=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional alias for migrations if you want DATABASE_URL to mean something else:
# DATABASE_URL_SESSION=

# For local `next dev` Hyperdrive binding (optional). Prefer DATABASE_URL_POOLED.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=<same as DATABASE_URL_POOLED>

# Session signing secret (long random string, 32+ characters recommended)
SESSION_SECRET=replace-with-a-long-random-secret

# bcrypt password hashes for founder accounts (base64-encoded)
# Generate with: npm run hash-password -- "your-password"
# The script prints values safe to paste into .env files (no $ expansion issues).
JON_PASSWORD_HASH=replace_with_base64_bcrypt_hash_for_jon
AHMED_PASSWORD_HASH=replace_with_base64_bcrypt_hash_for_ahmed

# Optional: Supabase project URL (not required by the app when using DATABASE_URL)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# ---------------------------------------------------------------------------
# AI — private company/customer data (OpenAI API, server-side only)
# Stage 2 evidence matching. Never expose these to the browser.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# Fast path (reasoning_effort=none): e.g. gpt-6-luna
# OPENAI_FAST_MODEL=gpt-6-luna
# Reasoning fallback (reasoning_effort=low): e.g. gpt-6-sol — only when Luna is ambiguous
# OPENAI_REASONING_MODEL=gpt-6-sol

# Optional web research (Stage 3+ — leave unset)
# WEB_RESEARCH_PROVIDER=stub
# WEB_RESEARCH_API_KEY=
